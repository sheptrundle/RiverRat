# SITE_ADDRESS is the public hostname (e.g. riverrat.example.com) for automatic HTTPS,
# or ":80" to serve plain HTTP (behind Cloudflare's proxy, or for a local test).
{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# Hashed assets never change; the page itself should always be fresh.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Keep search engines out until AW has been asked (README, Data and attribution).
		# Delete this line to let the site be indexed.
		X-Robots-Tag "noindex, nofollow"
	}
}
