# Copy to .env to override defaults. docker compose reads .env automatically.
POSTGRES_USER=riverrat
POSTGRES_PASSWORD=riverrat
POSTGRES_DB=riverrat
POSTGRES_PORT=5432

# Used when running the backend on the host (uv run ...).
# Inside docker compose, the api service points at the `db` container instead.
DATABASE_URL=postgresql+psycopg://riverrat:riverrat@localhost:5432/riverrat

# USGS Water Data API key (https://api.waterdata.usgs.gov/signup). Raises rate limits.
USGS_API_KEY=
